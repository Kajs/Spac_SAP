projection;
strict ( 2 );

define behavior for ZC_SPAC103_CART_PV alias Cart
use etag
{
  use create;
  use update;
  use delete;

  use action AddProduct;

  use association _Items { create; }
}


define behavior for ZC_SPAC103_CITEM_PV alias Item
use etag
{
  use update;
  use delete;

  use association _Cart;
}