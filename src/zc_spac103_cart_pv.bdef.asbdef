projection;
strict ( 2 );
use draft;

define behavior for ZC_SPAC103_CART_PV alias Cart
use etag
{
  use create;
  use update;
  use delete;

  use action AddProduct;
  use action Checkout;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Items { with draft; }
}


define behavior for ZC_SPAC103_CITEM_PV alias Item
use etag
{
  use update;
  use delete;

  use association _Cart { with draft; }
}