@Metadata.layer: #CUSTOMER
@UI.createHidden: false
@UI.deleteHidden: false
annotate entity ZC_SPAC103_STOCK_DD_PV
    with
{
    @UI.facet: [
      {
        id: 'StockDetails',
        purpose: #STANDARD,
        type: #IDENTIFICATION_REFERENCE,
        label: 'Stock Details',
        position: 10
      }
    ]
    @EndUserText.label: 'Warehouse Name'
    @UI.lineItem: [{ position: 10 }]
    @UI.identification: [{ position: 10 }]
    WarehouseName;
    
    @EndUserText.label: 'Warehouse City'
    @UI.lineItem: [{ position: 20 }]
    @UI.identification: [{ position: 20 }]
    WarehouseCity;
    
    @EndUserText.label: 'Product Name'
    @UI.lineItem: [{ position: 30 }]
    @UI.identification: [{ position: 30 }]
    ProductName;
    
    @EndUserText.label: 'Amount'
    @UI.lineItem: [{ position: 40 }]
    @UI.identification: [{ position: 40 }]
    Amount;
    
    @EndUserText.label: 'Warehouse ID'
    @UI.lineItem: [{ position: 50 }]
    @UI.identification: [{ position: 50 }]
    WarehouseId;

    @EndUserText.label: 'Product ID'
    @UI.lineItem: [{ position: 60 }]
    @UI.identification: [{ position: 60 }]
    ProductId;

    @EndUserText.label: 'Product Description'
    @UI.identification: [{ position: 70 }]
    ProductDescription;

    @EndUserText.label: 'Warehouse Address'
    @UI.identification: [{ position: 80 }]
    WarehouseAddress;

    @EndUserText.label: 'Warehouse ZIP Code'
    @UI.identification: [{ position: 90 }]
    WarehouseZipcode;

}