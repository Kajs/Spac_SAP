projection;
strict ( 2 );
use draft;

define behavior for ZC_SPAC103_PRODUCT_DD_PV
use etag
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Prices { create; with draft; }
}

define behavior for ZC_SPAC103_P_PRICE_PV
use etag
{
  use update;
  use delete;

  use association _Product { with draft; }
}